# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local credentials and environment
.env
.env.*
!.env.example
api.txt
*api_key*
*secret*

# Solver and experiment outputs
artifacts/
autosimp_output/
autosimp_smoke_test/
results*/
paper_figures/
*.npy
*.npz
*.log

# Node/Vite
node_modules/
dist/
tmp_build_verify*/
.vite/

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.tmp

# The manuscript evidence archive is intentionally versioned, including
# retained result folders and density arrays that would otherwise match the
# generic local-output rules above.
!reproducibility/**

# The deposited head-to-head, surfacing, spec-match and pipeline result files
# cited by the manuscript are versioned deliberately; they would otherwise be
# caught by the generic results*/ rule above.
!results/
!results/**
